{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Risposta all'handshake (server -> client, in chiaro)",
  "type": "object",
  "required": ["session_id", "B"],
  "properties": {
    "session_id": { "type": "string", "pattern": "^[0-9a-f]{8}$", "description": "identificativo della sessione" },
    "B": { "type": "string", "pattern": "^[0-9]+$", "description": "chiave pubblica del server B = g^b mod p" }
  },
  "additionalProperties": false
}
